# ============================================================
# SmartStay TV — Environment Variables Reference
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# ───────────────────────────────────────────────────────────
# APP
# ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ───────────────────────────────────────────────────────────
# DATABASE
# ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://smartstay:smartstay_dev_password@localhost:5432/smartstay?schema=public

# ───────────────────────────────────────────────────────────
# REDIS
# ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ───────────────────────────────────────────────────────────
# JWT
# ───────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_min_64_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ───────────────────────────────────────────────────────────
# DEVICE TOKEN (for TV authentication)
# ───────────────────────────────────────────────────────────
DEVICE_TOKEN_SECRET=change_this_to_device_token_secret_min_64_chars
DEVICE_TOKEN_EXPIRES_IN=365d

# ───────────────────────────────────────────────────────────
# ENCRYPTION (for PMS credentials and sensitive config)
# ───────────────────────────────────────────────────────────
ENCRYPTION_KEY=change_this_32_char_hex_key_for_aes256

# ───────────────────────────────────────────────────────────
# FILE STORAGE
# ───────────────────────────────────────────────────────────
STORAGE_TYPE=local
# For production S3-compatible storage:
# STORAGE_TYPE=s3
# S3_BUCKET=smartstay-uploads
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_ENDPOINT=https://s3.amazonaws.com
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ───────────────────────────────────────────────────────────
# CORS
# ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ───────────────────────────────────────────────────────────
# RATE LIMITING
# ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ───────────────────────────────────────────────────────────
# EMAIL (optional — for password reset)
# ───────────────────────────────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# EMAIL_FROM=noreply@smartstaytv.com

# ───────────────────────────────────────────────────────────
# SUPER ADMIN
# ───────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@smartstaytv.com
SUPER_ADMIN_PASSWORD=change_this_before_production

# ───────────────────────────────────────────────────────────
# TV PAIRING
# ───────────────────────────────────────────────────────────
PAIRING_CODE_EXPIRY_MINUTES=15
PAIRING_CODE_LENGTH=6

# ───────────────────────────────────────────────────────────
# HEARTBEAT
# ───────────────────────────────────────────────────────────
DEVICE_OFFLINE_THRESHOLD_MINUTES=5
HEARTBEAT_INTERVAL_SECONDS=60

